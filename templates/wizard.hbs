{{!-- Hueco con tirada y/o elección: se usa en características y vida pasada. --}}
{{#*inline "slot"}}
<div class="cprgen-slot {{#unless answered}}empty{{/unless}}">
  <span class="cprgen-slot-label">{{label}}</span>
  <span class="cprgen-slot-value">{{#if answered}}{{text}}{{#if rolled}} <em class="cprgen-rolled">({{localize "CPRGEN.slot.rolled"}} {{rolled}})</em>{{/if}}{{else}}<em>{{localize "CPRGEN.slot.empty"}}</em>{{/if}}</span>
  <span class="cprgen-slot-actions">
    {{#if canRoll}}<button type="button" data-action="rollSlot" data-key="{{key}}" title="{{die}}"><i class="fas fa-dice-d10"></i> {{#if answered}}{{localize "CPRGEN.slot.reroll"}}{{else}}{{localize "CPRGEN.slot.roll"}}{{/if}}{{#if die}} {{die}}{{/if}}</button>{{/if}}
    {{#if canRequest}}<button type="button" data-action="requestReroll" data-key="{{key}}" data-label="{{label}}"><i class="fas fa-hand-paper"></i> {{localize "CPRGEN.slot.request"}}</button>{{/if}}
    {{#if canChoose}}
      <select data-key="{{key}}" data-kind="{{kind}}">
        <option value="">{{localize "CPRGEN.slot.choose"}}</option>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    {{/if}}
  </span>
</div>
{{/inline}}

<div class="cprgen-layout">
  <nav class="cprgen-steps">
    {{#each steps}}
      <button type="button" class="cprgen-step {{#if current}}current{{/if}} {{#if done}}done{{/if}}" data-action="goStep" data-step="{{id}}" {{#if locked}}disabled{{/if}}>
        <span class="n">{{n}}</span> {{label}}
      </button>
    {{/each}}
    <p class="cprgen-policy">{{localize "CPRGEN.wizard.policy"}}: {{policy}}</p>
    {{#if isGM}}<button type="button" class="cprgen-reset" data-action="resetDraft"><i class="fas fa-eraser"></i> {{localize "CPRGEN.wizard.reset"}}</button>{{/if}}
  </nav>

  <section class="cprgen-body">
    <h2>{{stepLabel}}{{#if methodLabel}} <small>· {{methodLabel}}</small>{{/if}}{{#if role}} <small>· {{role.name}}</small>{{/if}}</h2>

    {{#if step.method}}
      <p>{{localize "CPRGEN.method.intro"}}</p>
      <div class="cprgen-methods">
        {{#each methods}}
          <button type="button" class="cprgen-method {{#if selected}}selected{{/if}}" data-action="selectMethod" data-method="{{id}}">
            <strong>{{label}}</strong>
            <span>{{hint}}</span>
          </button>
        {{/each}}
      </div>
    {{else if pending}}
      <p class="cprgen-pending">{{localize "CPRGEN.wizard.pending"}}</p>
    {{else if needRole}}
      <p class="cprgen-pending">{{localize "CPRGEN.wizard.needRole"}}</p>
    {{else if step.role}}
      <p>{{localize "CPRGEN.role.intro"}}</p>
      <div class="cprgen-roles">
        {{#each roles}}<button type="button" class="cprgen-role {{#if selected}}selected{{/if}}" data-action="selectRole" data-role="{{key}}">{{name}}</button>{{/each}}
      </div>
    {{else if step.stats}}
      {{#if stats.buy}}
        <p>{{localize "CPRGEN.stats.introComplete" min=stats.min max=stats.max rank=stats.rank budget=stats.budget}}</p>
        <p class="cprgen-points {{#if stats.over}}over{{/if}}"><strong>{{localize "CPRGEN.skills.points" spent=stats.spent budget=stats.budget remaining=stats.remaining}}</strong>{{#if stats.over}} — {{localize "CPRGEN.skills.over"}}{{/if}}</p>
        <table class="cprgen-table cprgen-skills">
          <tbody>{{#each stats.rows}}<tr><td>{{label}}</td><td><input type="number" data-stat-key="{{key}}" value="{{value}}" min="{{../stats.min}}" max="{{../stats.max}}" step="1"></td></tr>{{/each}}</tbody>
        </table>
      {{else if stats.perStat}}
        <p>{{localize "CPRGEN.stats.introEdgerunner"}}</p>
        {{#each stats.slots}}{{> slot this}}{{/each}}
        <table class="cprgen-table">
          <thead><tr><th>1d10</th>{{#each stats.header}}<th>{{this}}</th>{{/each}}</tr></thead>
          <tbody>{{#each stats.table}}<tr><td>{{n}}</td>{{#each values}}<td class="{{#if selected}}selected{{/if}}">{{v}}</td>{{/each}}</tr>{{/each}}</tbody>
        </table>
      {{else}}
        <p>{{localize "CPRGEN.stats.introStreetrat"}}</p>
        {{> slot stats.slot}}
        <table class="cprgen-table">
          <thead><tr><th>1d10</th>{{#each stats.header}}<th>{{this}}</th>{{/each}}</tr></thead>
          <tbody>{{#each stats.table}}<tr class="{{#if selected}}selected{{/if}}"><td>{{n}}</td>{{#each values}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</tbody>
        </table>
      {{/if}}
    {{else if step.skills}}
      {{#if skills.complete}}
        <p>{{localize "CPRGEN.skills.introComplete"}}</p>
        <p class="cprgen-points {{#if skills.complete.over}}over{{/if}}"><strong>{{localize "CPRGEN.skills.points" spent=skills.complete.spent budget=skills.complete.budget remaining=skills.complete.remaining}}</strong>{{#if skills.complete.over}} — {{localize "CPRGEN.skills.over"}}{{/if}}</p>
        <table class="cprgen-table cprgen-skills">
          <thead><tr><th>{{localize "CPRGEN.step.skills"}}</th><th></th><th>{{localize "CPRGEN.skills.level"}}</th><th>{{localize "CPRGEN.skills.cost"}}</th></tr></thead>
          <tbody>{{#each skills.complete.rows}}<tr class="{{#if basic}}basic{{/if}}"><td>{{label}}{{#if x2}} (x2){{/if}}{{#if basic}} *{{/if}}
            {{#if spec}}<select data-key="{{spec.key}}" data-kind="uuid"><option value="">{{localize "CPRGEN.skills.chooseSpecialty"}}</option>{{#each spec.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}</td>
            <td>{{stat}}</td><td><input type="number" data-skill-key="{{key}}" value="{{level}}" min="{{min}}" max="{{max}}" step="1"></td><td>{{cost}}</td></tr>{{/each}}</tbody>
        </table>
        <p class="hint">{{localize "CPRGEN.skills.basicNote"}}</p>
      {{else if skills.points}}
        <p>{{localize "CPRGEN.skills.introEdgerunner" min=skills.points.min max=skills.points.max budget=skills.points.budget}}</p>
        <p class="cprgen-points {{#if skills.points.over}}over{{/if}}"><strong>{{localize "CPRGEN.skills.points" spent=skills.points.spent budget=skills.points.budget remaining=skills.points.remaining}}</strong>{{#if skills.points.over}} — {{localize "CPRGEN.skills.over"}}{{/if}}</p>
        <table class="cprgen-table cprgen-skills">
          <thead><tr><th>{{localize "CPRGEN.step.skills"}}</th><th>{{localize "CPRGEN.skills.level"}}</th><th>{{localize "CPRGEN.skills.cost"}}</th></tr></thead>
          <tbody>{{#each skills.points.rows}}<tr><td>{{label}}{{#if x2}} (x2){{/if}}{{#if spec}} → <strong>{{spec}}</strong>{{/if}}</td>
            <td><input type="number" data-skill-key="{{key}}" value="{{level}}" min="{{../skills.points.min}}" max="{{../skills.points.max}}" step="1"></td><td>{{cost}}</td></tr>{{/each}}</tbody>
        </table>
      {{else}}
        <p>{{localize "CPRGEN.skills.introStreetrat"}}</p>
        <table class="cprgen-table cprgen-skills">
          <tbody>{{#each skills.list}}<tr><td>{{label}}{{#if spec}} → <strong>{{spec}}</strong>{{/if}}</td><td>{{level}}</td></tr>{{/each}}</tbody>
        </table>
      {{/if}}
      {{#each skills.specs}}
        <div class="cprgen-slot">
          <span class="cprgen-slot-label">{{label}} ({{level}})</span>
          <select data-key="{{key}}" data-kind="uuid"><option value="">{{localize "CPRGEN.slot.choose"}}</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </div>
      {{/each}}
      <div class="cprgen-slot">
        <span class="cprgen-slot-label">{{localize "CPRGEN.skills.originLanguage" level=skills.lang.level}}</span>
        <select data-key="lang.origin" data-kind="uuid"><option value="">{{localize "CPRGEN.slot.choose"}}</option>{{#each skills.lang.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <input type="text" data-text-key="lang.origin" value="{{skills.lang.other}}" placeholder="{{localize "CPRGEN.skills.otherLanguage"}}">
      </div>
      {{#if skills.lang.suggested}}<p class="hint">{{localize "CPRGEN.skills.suggested"}}: {{skills.lang.suggested}}</p>{{else}}<p class="hint">{{localize "CPRGEN.skills.suggestedNone"}}</p>{{/if}}
    {{else if step.lifepath}}
      <p>{{localize "CPRGEN.lifepath.intro"}} <strong>{{localize "CPRGEN.lifepath.progress" done=lifepath.done total=lifepath.total missing=lifepath.missing}}</strong></p>
      {{#each lifepath.groups}}
        <fieldset class="cprgen-group"><legend>{{label}}</legend>
          {{#each slots}}{{> slot this}}{{/each}}
        </fieldset>
      {{/each}}
    {{else if gear.shop}}
      <p>{{localize "CPRGEN.shop.intro" money=gear.totals.money fashion=gear.totals.fashionMoney}}</p>
      {{#if gear.edgerunners}}<p class="hint">{{localize "CPRGEN.shop.intro2070"}}</p>{{/if}}
      <p class="cprgen-points {{#if gear.totals.over}}over{{/if}}"><strong>{{localize "CPRGEN.shop.totals" main=gear.totals.mainSpent money=gear.totals.money left=gear.totals.mainLeft fashion=gear.totals.fashionUsed fashionMoney=gear.totals.fashionMoney}}</strong>{{#if gear.totals.over}} — {{localize "CPRGEN.skills.over"}}{{/if}}</p>
      <fieldset class="cprgen-group"><legend>{{localize "CPRGEN.shop.cart"}}</legend>
        {{#if gear.cart.length}}
        <table class="cprgen-table cprgen-cart">
          <thead><tr><th>{{localize "CPRGEN.shop.item"}}</th><th>{{localize "CPRGEN.shop.packs"}}</th><th>{{localize "CPRGEN.shop.price"}}</th><th>{{localize "CPRGEN.shop.subtotal"}}</th><th></th></tr></thead>
          <tbody>{{#each gear.cart}}<tr><td>{{name}}{{#if fashion}} <em>({{localize "CPRGEN.shop.fashion"}})</em>{{/if}}{{#if units}} <em>= {{units}} u.</em>{{/if}}</td>
            <td><input type="number" data-cart-index="{{index}}" value="{{packs}}" min="0" step="1"></td><td>{{price}}</td><td>{{subtotal}}</td>
            <td><button type="button" data-action="cartRemove" data-index="{{index}}" title="{{localize "CPRGEN.shop.remove"}}"><i class="fas fa-trash"></i></button></td></tr>{{/each}}</tbody>
        </table>
        {{else}}<p class="hint">{{localize "CPRGEN.shop.empty"}}</p>{{/if}}
      </fieldset>
      <fieldset class="cprgen-group"><legend>{{#if gear.edgerunners}}{{localize "CPRGEN.shop.catalog2070"}}{{else}}{{localize "CPRGEN.shop.catalog"}}{{/if}}</legend>
        <div class="cprgen-shopbar">
          <select data-shop-pack>{{#each gear.packs}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <input type="search" data-shop-query value="{{gear.query}}" placeholder="{{localize "CPRGEN.shop.search"}}">
        </div>
        <table class="cprgen-table cprgen-catalog">
          <tbody>{{#each gear.list}}<tr><td>{{name}}{{#if packSize}} <em>(x{{packSize}})</em>{{/if}}</td><td>{{price}} ed</td>
            <td><button type="button" data-action="shopAdd" data-uuid="{{uuid}}"><i class="fas fa-cart-plus"></i></button></td></tr>{{/each}}</tbody>
        </table>
        {{#if gear.more}}<p class="hint">{{localize "CPRGEN.shop.more"}}</p>{{/if}}
      </fieldset>
    {{else if step.gear}}
      <p>{{localize "CPRGEN.gear.intro"}}</p>
      {{#each gear.groups}}
        <fieldset class="cprgen-group"><legend>{{label}}</legend>
          {{#each lines}}
            {{#if choose}}
              <div class="cprgen-slot"><span class="cprgen-slot-label">{{localize "CPRGEN.gear.chooseOne"}}</span>
                <select data-key="{{key}}" data-kind="row"><option value="">{{localize "CPRGEN.slot.choose"}}</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
            {{else}}<div class="cprgen-line">{{text}}</div>{{/if}}
          {{/each}}
        </fieldset>
      {{/each}}
      <p class="hint">{{gear.humanity}}</p>
    {{else if step.review}}
      {{#if review.ready}}
        <dl class="cprgen-summary">
          <dt>{{localize "CPRGEN.step.role"}}</dt><dd>{{review.summary.role}}</dd>
          <dt>{{localize "CPRGEN.step.stats"}}</dt><dd>{{review.summary.stats}}</dd>
          <dt>{{localize "CPRGEN.step.skills"}}</dt><dd>{{review.summary.skills}}</dd>
          <dt>{{localize "CPRGEN.step.gear"}}</dt><dd>{{review.summary.items}}</dd>
          <dt>{{localize "CPRGEN.review.clothing"}}</dt><dd>{{review.summary.clothing}}</dd>
          <dt>{{localize "CPRGEN.review.money"}}</dt><dd>{{review.summary.money}} ed</dd>
          <dt>{{localize "CPRGEN.review.housing"}}</dt><dd>{{review.summary.housing}}</dd>
        </dl>
        {{#if review.applied}}<p class="hint">{{localize "CPRGEN.review.applied" date=review.applied}} {{localize "CPRGEN.review.replaceNote"}}</p>{{/if}}
        <p>{{localize "CPRGEN.review.note"}}</p>
        {{#if review.edgerunners}}<p class="hint">{{localize "CPRGEN.review.neuroport"}}</p>{{/if}}
        <button type="button" class="cprgen-apply" data-action="applySheet"><i class="fas fa-file-import"></i> {{#if review.needAuth}}{{localize "CPRGEN.review.requestApply"}}{{else if review.applied}}{{localize "CPRGEN.review.reapply"}}{{else}}{{localize "CPRGEN.review.apply"}}{{/if}}</button>
      {{else}}
        <p>{{localize "CPRGEN.review.missingIntro"}}</p>
        <ul>{{#each review.missing}}<li>{{this}}</li>{{/each}}</ul>
      {{/if}}
    {{/if}}
  </section>

  <footer class="cprgen-footer">
    <button type="button" data-action="prev" {{#unless canPrev}}disabled{{/unless}}><i class="fas fa-chevron-left"></i> {{localize "CPRGEN.wizard.prev"}}</button>
    <button type="button" data-action="next" {{#unless canNext}}disabled{{/unless}}>{{localize "CPRGEN.wizard.next"}} <i class="fas fa-chevron-right"></i></button>
  </footer>
</div>
